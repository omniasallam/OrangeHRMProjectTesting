<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Suite" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="base.RetryListener"/>
        <listener class-name="base.TestListener"/>
    </listeners>
    <test name="Login Tests">
        <classes><class name="tests.LoginTest"/></classes>
    </test>
    <test name="PIM Tests">
        <classes>
            <class name="tests.EmployeeListTest"/>
            <class name="tests.AddEmployeeTest"/>
        </classes>
    </test>
    <test name="Admin and UI Tests">
        <classes>
            <class name="tests.AdminTest"/>
            <class name="tests.FooterTest"/>
            <class name="tests.SideMenuTest"/>
        </classes>
    </test>
</suite>
